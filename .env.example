PORT=3000
DATABASE_URL=postgresql://postgres.xxxx:your-password@aws-0-region.pooler.supabase.com:5432/postgres
SESSION_SECRET=change-this-to-a-long-random-string
# path to Supabase's certificate file (Supabase dashboard > Project Settings > Database > SSL Configuration > Download certificate)
# DATABASE_CA_FILE=./prod-ca-2021.crt
# only on a host that puts an https proxy in front of the app (Render does this by itself, so leave it out there and locally)
# TRUST_PROXY=1
